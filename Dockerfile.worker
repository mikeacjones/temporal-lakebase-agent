ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TEMPORAL_WORKER_READY_FILE=/tmp/temporal-worker-ready

WORKDIR /app

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[lakebase]"

USER 10001:10001

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD ["python", "-c", "from pathlib import Path; raise SystemExit(0 if Path('/tmp/temporal-worker-ready').is_file() else 1)"]

CMD ["python", "-m", "lakebase_agentworkflow.worker"]

