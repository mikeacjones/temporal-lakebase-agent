# Temporal Cloud. The web/API uses these values directly.
# In production worker pods, Temporal Worker Controller injects TEMPORAL_ADDRESS,
# TEMPORAL_NAMESPACE, TEMPORAL_DEPLOYMENT_NAME, and TEMPORAL_WORKER_BUILD_ID.
# Do not set those four variables manually in the WorkerDeployment pod template.
TEMPORAL_ADDRESS=us-west-2.aws.api.temporal.io:7233
TEMPORAL_NAMESPACE=tf-demo.zsvab
TEMPORAL_TASK_QUEUE=lakebase-agent-task-queue
TEMPORAL_API_KEY=replace-with-temporal-cloud-api-key
TEMPORAL_TLS=true

# Agent model activity
# scripted = no external model call; openai = use OpenAI from the activity
AGENT_MODEL_PROVIDER=scripted
AGENT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=replace-with-openai-api-key

# Off-platform Databricks OAuth for the EKS worker and web/API workloads.
# Use separate service principals/secrets per workload when practical.
DATABRICKS_HOST=https://dbc-33a81e40-df8b.cloud.databricks.com
DATABRICKS_AUTH_TYPE=oauth-m2m
DATABRICKS_CLIENT_ID=replace-with-databricks-service-principal-client-id
DATABRICKS_CLIENT_SECRET=replace-with-databricks-service-principal-client-secret

# Lakebase activity behavior
# endpoint = EKS/off-platform connection using LAKEBASE_ENDPOINT and Databricks OAuth
# disabled = log-only repository for isolated local tests
# url = local-development-only connection using LAKEBASE_PG_URL
LAKEBASE_CONNECTION_MODE=endpoint
LAKEBASE_SCHEMA=agent_ops
LAKEBASE_POLICY_SCHEMA=agent_policy
LAKEBASE_POOL_SIZE=5
LAKEBASE_MAX_OVERFLOW=10
LAKEBASE_ENDPOINT=projects/temporal-lakebase-agentworkflow/branches/production/endpoints/primary
LAKEBASE_DATABASE=databricks_postgres
# The Lakebase Postgres role name is the service principal client/application ID.
LAKEBASE_USER=replace-with-databricks-service-principal-client-id
# Local development only; do not use a static Postgres password URL on EKS.
LAKEBASE_PG_URL=postgresql://user:password@host:5432/databricks_postgres?sslmode=require

# Presenter-only pacing for the crash-recovery demo; keep zero in normal runs.
DEMO_TOOL_DELAY_SECONDS=0
