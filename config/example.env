# Local Temporal server defaults. tmprl-demo.cloud injects its own Cloud values.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=lakebase-agent-task-queue
TEMPORAL_TLS=false
TEMPORAL_UI_URL=http://localhost:8233

# scripted requires no external model credential.
# For model-backed activities, set AGENT_MODEL_PROVIDER=openai and provide
# OPENAI_API_KEY through the runtime secret manager.
AGENT_MODEL_PROVIDER=scripted
AGENT_MODEL=gpt-4.1-mini

# Isolated local development does not require Lakebase.
LAKEBASE_CONNECTION_MODE=disabled
LAKEBASE_SCHEMA=agent_ops
LAKEBASE_POLICY_SCHEMA=agent_policy
LAKEBASE_POOL_SIZE=5
LAKEBASE_MAX_OVERFLOW=10
LAKEBASE_TOKEN_REFRESH_SECONDS=2400

# Off-platform Lakebase endpoint mode. Uncomment and replace these values when
# testing with the same OAuth shape used by tmprl-demo.cloud.
# DATABRICKS_HOST=https://<workspace-host>
# DATABRICKS_AUTH_TYPE=oauth-m2m
# DATABRICKS_CLIENT_ID=<service-principal-client-id>
# DATABRICKS_CLIENT_SECRET=<service-principal-client-secret>
# LAKEBASE_CONNECTION_MODE=endpoint
# LAKEBASE_ENDPOINT=projects/<project>/branches/production/endpoints/primary
# LAKEBASE_DATABASE=databricks_postgres
# LAKEBASE_USER=<service-principal-client-id>

# Local-development-only alternative. Do not use a static Postgres password in
# a deployed environment.
# LAKEBASE_CONNECTION_MODE=url
# LAKEBASE_PG_URL=postgresql://user:password@host:5432/databricks_postgres?sslmode=require

DEMO_TOOL_DELAY_SECONDS=0
